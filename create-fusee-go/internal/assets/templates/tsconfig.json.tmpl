{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,{{if .IsJSX}}
    "jsx": "react-jsx",
    "jsxImportSource": "./framework/core",{{end}}
    "paths": {
      "fusee-framework": ["./framework/types/index.d.ts"],
      "fusee-framework/router": ["./framework/types/router.d.ts"],
      "fusee-framework/store": ["./framework/types/store.d.ts"],
      "fusee-framework/di": ["./framework/types/di-entry.d.ts"],
      "fusee-framework/actions": ["./framework/types/actions.d.ts"],
      "fusee-framework/plugins": ["./framework/types/plugins.d.ts"]
    }
  },
  "include": ["app/**/*", "framework/**/*", "auto-imports.d.ts"]
}
