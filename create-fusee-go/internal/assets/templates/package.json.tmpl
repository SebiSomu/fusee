{
  "name": "{{.ProjectName}}",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"const fs=require('fs');if(!fs.existsSync('framework/engine-go')){console.error('\\nGo SSR Engine not installed.\\nRun: fusee add server\\n');process.exit(1);}\" && node ./framework/server/generate-manifest.js && cd framework/engine-go && go run ./cmd/server",
    "dev:spa": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "manifest": "node ./framework/server/generate-manifest.js"
  },
  "devDependencies": {
    "fast-glob": "^3.3.3",
    "unplugin-auto-import": "^0.17.0",
    "vite": "^5.0.0"{{if .IsTS}},
    "typescript": "^5.0.0"{{end}}{{if .IsJSX}},
    "vite-plugin-babel": "^0.2.0",
    "@babel/core": "^7.24.0",
    "@babel/plugin-syntax-jsx": "^7.24.0"{{if .IsTS}},
    "@babel/plugin-syntax-typescript": "^7.24.0"{{end}}{{end}}
  }
}
